# Every variable is read ONLY by src/config.ts. In the cluster they come from the
# ConfigMap (non-secret) and the Secret (DB_PASSWORD) you write in k8s/.

# HTTP port the API listens on (must match containerPort in the Deployment)
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Shown by GET /whoami so you can watch a rolling update happen (baked into the image too)
APP_VERSION=dev

# Postgres connection. Locally: any Postgres on 5433. In the cluster: the postgres Service.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=wl_34
DB_USER=postgres
DB_PASSWORD=postgres

# Graceful shutdown: how long /readyz reports 503 before we stop accepting connections,
# and how long in-flight requests get to finish after that.
SHUTDOWN_DELAY_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Where the migration runner looks for NNN_name.sql files
MIGRATIONS_DIR=migrations
