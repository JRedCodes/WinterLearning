# Comma-separated list of Kafka bootstrap servers (docker compose exposes the broker on 9092)
KAFKA_BROKERS=localhost:9092
# Identifies this app in broker logs and metrics
KAFKA_CLIENT_ID=wl-32-orders
# Topic that carries order events, and how many partitions to create it with
ORDERS_TOPIC=orders.v1
ORDERS_PARTITIONS=3
# Consumer group of the customer-totals projection
PROJECTION_GROUP_ID=customer-totals
