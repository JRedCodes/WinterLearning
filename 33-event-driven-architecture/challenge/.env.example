# HTTP port of the orders API
PORT=3000
# Postgres (docker compose exposes it on 5433). Each module uses its own database.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wl_33
# Kafka bootstrap servers (docker compose exposes the broker on 9092)
KAFKA_BROKERS=localhost:9092
# Topic for order events, and where the payments consumer parks messages it can't process
ORDERS_TOPIC=orders.v1
PAYMENTS_DLQ_TOPIC=orders.v1.payments-dlq
# Consumer group of the payments service
PAYMENTS_GROUP_ID=payments
# How often the outbox relay polls for unpublished events, and how many it takes per run
RELAY_INTERVAL_MS=500
RELAY_BATCH_SIZE=100
# Attempts per message before it goes to the dead-letter topic
MAX_ATTEMPTS=3
