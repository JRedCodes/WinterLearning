# Port the API listens on
PORT=3000
# Postgres connection (this module uses its own database, wl_25)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wl_25
# Where uploaded file contents are stored on disk
STORAGE_DIR=./storage
# Comma-separated list of browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173
