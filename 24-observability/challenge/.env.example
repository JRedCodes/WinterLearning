# Port the checkout API listens on
PORT=3000
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Name stamped on every log line (the "service" field)
SERVICE_NAME=checkout
# Base URL of the payments service (run `make fake-payments` for a local fake)
PAYMENTS_URL=http://localhost:4001
# How long /readyz waits for each dependency check before calling it failed
READINESS_TIMEOUT_MS=1000
