# Copy to .env (never commit .env) and adjust if your ports differ.
# The defaults below match the docker-compose.yml you write in this challenge.

# Postgres: host port 5433 (not 5432, so it never clashes with a locally installed Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wl_00

# Redis: host port 6380, logical database 0 (module id 00 mod 16)
REDIS_URL=redis://localhost:6380/0
