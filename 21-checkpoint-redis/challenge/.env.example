# Port the HTTP API listens on
PORT=3000

# Postgres: this module's own database (created automatically by the tests).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wl_21

# Redis: database index 5 (= module id 21 mod 16). All keys start with "wl:21:".
REDIS_URL=redis://localhost:6380/5

# Comma-separated list of valid API keys (X-API-Key header)
API_KEYS=dev-key-1,dev-key-2

# Per-API-key rate limit on /previews
RATE_LIMIT=30
RATE_LIMIT_WINDOW_MS=60000

# How long a ready preview stays in the Redis cache
CACHE_TTL_SECONDS=3600

# Fetch job retry policy
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=1000
