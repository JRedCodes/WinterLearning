# development | test | production (default: development)
NODE_ENV=development
# Port the HTTP server listens on (default: 3000)
PORT=3000
# debug | info | warn | error | silent
# default depends on NODE_ENV: development=debug, test=silent, production=info
LOG_LEVEL=debug
# Page size used when the client sends no ?limit= (default: 20)
DEFAULT_PAGE_SIZE=20
# Largest ?limit= a client may ask for (default: 100)
MAX_PAGE_SIZE=100
# Secret required in the X-Api-Key header for write requests.
# Optional in development/test, REQUIRED in production (min 16 chars).
# Never commit a real value: put it in .env (gitignored) or your secret manager.
API_KEY=
