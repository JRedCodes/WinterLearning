# Port the demo API listens on (npm run dev)
PORT=3000

# Redis connection. Database index 3 (= module id 19 mod 16) keeps this module
# isolated from the others. Every key this module writes starts with "wl:19:".
REDIS_URL=redis://localhost:6380/3

# Requests allowed per API key (or IP) per minute on /api/*
API_LIMIT_PER_MINUTE=60

# Login attempts allowed per IP+username: bucket size and refill rate
LOGIN_BURST=5
LOGIN_REFILL_PER_MINUTE=5

# Set to the number of proxies in front of the app (e.g. 1 behind a load
# balancer) so req.ip is the real client address. 0 = trust nobody.
TRUST_PROXY_HOPS=0
