# Port the aggregator listens on (npm run dev)
PORT=3000

# Real downstream base URLs. Leave unset to use the built-in simulated
# (flaky) downstreams, which is what you want for experimenting.
# CATALOG_URL=http://localhost:4001
# PRICING_URL=http://localhost:4002
# REVIEWS_URL=http://localhost:4003

# Fault injection for the simulated downstreams:
#   *_LATENCY_MS    typical latency
#   *_FAILURE_RATE  0..1 chance of a 503
#   *_SLOW_RATE     0..1 chance of a 20x latency spike
CATALOG_LATENCY_MS=40
CATALOG_FAILURE_RATE=0.02
CATALOG_SLOW_RATE=0.01
PRICING_LATENCY_MS=60
PRICING_FAILURE_RATE=0.1
PRICING_SLOW_RATE=0.05
REVIEWS_LATENCY_MS=80
REVIEWS_FAILURE_RATE=0.3
REVIEWS_SLOW_RATE=0.1
