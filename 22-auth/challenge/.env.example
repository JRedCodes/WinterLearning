# Port the HTTP server listens on (npm run dev)
PORT=3000
# development | test | production. In production, cookies default to Secure.
NODE_ENV=development
# Postgres connection string. Each module uses its own database (wl_22 here).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wl_22
# Redis connection string. DB index = module id mod 16 = 6.
REDIS_URL=redis://localhost:6380/6
# Every Redis key this module writes starts with this prefix.
REDIS_KEY_PREFIX=wl:22:
# How long an idle session lives (seconds). Every authenticated request slides it forward.
SESSION_TTL_SECONDS=604800
# Set the Secure attribute on the session cookie. Defaults to true when NODE_ENV=production.
# Browsers treat http://localhost as a secure context, but curl over plain http will not send Secure cookies back.
COOKIE_SECURE=false
# Secret used by the legacy JWT service (Part B). Never commit real secrets.
LEGACY_JWT_SECRET=change-me-to-at-least-32-random-bytes
