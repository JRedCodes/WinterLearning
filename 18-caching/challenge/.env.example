# HTTP port for `npm run dev`
PORT=3000
# Postgres: database wl_18 (created by `make db-setup` / the test globalSetup)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wl_18
# Redis: database index 2 (= 18 mod 16). All keys start with "wl:18:".
REDIS_URL=redis://localhost:6380/2
# How long a product stays cached, and the +/- random spread applied to it
CACHE_TTL_SECONDS=300
CACHE_JITTER_RATIO=0.1
# How long a "this product doesn't exist" answer is cached
CACHE_NEGATIVE_TTL_SECONDS=30
# Artificial latency added to every product query, to simulate an expensive query
PRODUCT_QUERY_DELAY_MS=200
