PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wl_31
# DB index 15 (= 31 mod 16). Every key this app writes starts with REDIS_KEY_PREFIX.
REDIS_URL=redis://localhost:6380/15
REDIS_KEY_PREFIX=wl:31:
# Used to build shortUrl in responses: <PUBLIC_BASE_URL>/<code>
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated API keys accepted in the X-API-Key header
API_KEYS=dev-key-1,dev-key-2
# Link creation limit per API key: at most MAX per WINDOW seconds
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
# How long a resolved link stays in the Redis cache (capped by the link's own expiry)
CACHE_TTL_SECONDS=3600
# How often server.ts drains the click stream into Postgres
CLICK_DRAIN_INTERVAL_MS=1000
MIGRATIONS_DIR=migrations
