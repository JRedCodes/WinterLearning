# Port the chat server listens on (npm run dev). Run a second instance with
# PORT=3001 npm run dev to see cross-instance delivery through Redis.
PORT=3000

# Redis connection. Database index 12 (= module id 28 mod 16) keeps this
# module's keys isolated from other modules.
REDIS_URL=redis://localhost:6380/12

# Prefix for every Redis key and pub/sub channel. Pub/sub channels are global
# to the Redis server (they ignore the database index), so the prefix matters.
KEY_PREFIX=wl:28:

# HMAC secret used to sign and verify connection tokens (npm run token -- alice)
TOKEN_SECRET=dev-secret-change-me

# How often the server pings each WebSocket. A client that has not answered
# the previous ping by the next tick is considered dead and is terminated.
HEARTBEAT_MS=30000

# How often an SSE stream gets a ": keep-alive" comment so proxies don't cut it
SSE_KEEPALIVE_MS=15000

# A client whose unsent buffer grows past this many bytes is a slow consumer
# and gets disconnected (close code 1013).
MAX_BUFFERED_BYTES=1048576

# Messages kept per room in Redis
HISTORY_SIZE=50
