# Port the HTTP API listens on (npm run dev)
PORT=3000

# Redis connection. Database index 4 (= module id 20 mod 16) keeps this module
# isolated from the others. All BullMQ keys use the prefix "wl:20".
REDIS_URL=redis://localhost:6380/4

# Retry policy for every job: total attempts, and the exponential backoff
# (base delay, doubled per attempt, capped at max, with full jitter).
JOB_ATTEMPTS=5
JOB_BACKOFF_BASE_MS=1000
JOB_BACKOFF_MAX_MS=60000

# How many jobs each worker processes at the same time.
EMAIL_CONCURRENCY=5
THUMBNAIL_CONCURRENCY=2
