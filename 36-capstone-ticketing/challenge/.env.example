# ---- HTTP ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---- Postgres (each module has its own database: wl_36) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wl_36
DB_POOL_MAX=10

# ---- Redis (db index 36 mod 16 = 4; every key starts with wl:36:) ----
REDIS_URL=redis://localhost:6380/4
REDIS_KEY_PREFIX=wl:36:

# ---- Kafka (only the worker talks to Kafka) ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=wl-36-ticketing
KAFKA_TOPIC=ticketing.events

# ---- Auth ----
SESSION_TTL_SECONDS=86400
# scrypt cost. Must be a power of two. Tests use a cheap value to stay fast.
PASSWORD_SCRYPT_N=16384
# Comma-separated emails that become organizers when they register.
ORGANIZER_EMAILS=organizer@example.com

# ---- Holds & bookings ----
HOLD_TTL_SECONDS=600
MAX_SEATS_PER_HOLD=6

# ---- Caching & rate limiting ----
CACHE_TTL_SECONDS=60
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
HOLD_RATE_LIMIT=10
HOLD_RATE_WINDOW_SECONDS=60

# ---- Background work (worker process) ----
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_MS=500
HOLD_SWEEP_MS=5000
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_BACKOFF_MS=1000
