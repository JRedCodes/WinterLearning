# Copy to .env.local for `npm run dev`. Vite exposes ONLY variables prefixed with VITE_
# to browser code, and inlines them at build time: never put secrets here.

# Base URL of the tasks API (module 23's server, or any API with the same contract)
VITE_API_URL=http://localhost:3000
# Which project's tasks to show
VITE_PROJECT_ID=demo
