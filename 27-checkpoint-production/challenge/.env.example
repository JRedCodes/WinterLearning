PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wl_27
# DB index 11 (= 27 mod 16). Every key this app writes starts with REDIS_KEY_PREFIX.
REDIS_URL=redis://localhost:6380/11
REDIS_KEY_PREFIX=wl:27:
# Sessions
SESSION_TTL_SECONDS=86400
# Set to true behind HTTPS (always in production): adds the Secure flag to the session cookie
COOKIE_SECURE=false
# Login rate limit: at most MAX attempts per WINDOW seconds per (email, client IP)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Trust X-Forwarded-For from a reverse proxy (only if one is actually in front of you)
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
MIGRATIONS_DIR=migrations
LOG_LEVEL=info
