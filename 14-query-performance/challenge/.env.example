# Port the HTTP server listens on (npm run dev)
PORT=3000
# Postgres connection string (database wl_14 is created by the tests / make up)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wl_14
# Maximum number of connections in the pg Pool
DB_POOL_MAX=10
# Where migration .sql files live (relative to the challenge/ folder)
MIGRATIONS_DIR=migrations
# Log every SQL statement with its duration and a per-request query count (dev only)
LOG_QUERIES=false
