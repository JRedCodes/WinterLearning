# Port the HTTP server listens on (npm run dev)
PORT=3000
# Postgres connection string. Each module uses its own database (wl_15 here).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wl_15
# Max connections in the pg pool.
DB_POOL_MAX=10
# How long a request waits for a free pool connection before failing (ms).
DB_CONNECTION_TIMEOUT_MS=2000
