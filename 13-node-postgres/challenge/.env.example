# Port the HTTP server listens on (npm run dev)
PORT=3000
# Postgres connection string. The database is created by the tests if missing;
# for `npm run dev`, run `make up` first (the server runs migrations at startup).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/wl_13
# Maximum number of connections in the pg Pool
DB_POOL_MAX=10
# Shows up in pg_stat_activity.application_name, handy for spotting your app's connections
DB_APP_NAME=wl-13-tasks-api
# Where migration .sql files live (relative to the challenge/ folder)
MIGRATIONS_DIR=migrations
